# Used by docker-compose for PostgreSQL bootstrap + playground password.
# Copy to .env in the project root (same folder as docker-compose.yml).
# Keep this file off the public internet and out of git.

# Strong random password for the internal postgres bootstrap superuser
# (used only inside the Docker network for first-time init; never for the API)
POSTGRES_BOOTSTRAP_PASSWORD=change-me-bootstrap-superuser-password

# Password for the non-superuser playground role (used by the API)
PGPASSWORD=change-me-to-a-strong-db-password

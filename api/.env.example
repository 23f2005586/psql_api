# Copy to .env and fill in real values. Never commit .env.
# Never put API_KEY or database passwords in frontend JavaScript.

# Shared secret your website backend sends as: Authorization: Bearer <API_KEY>
API_KEY=change-me-to-a-long-random-string

# PostgreSQL (Docker service name on sql-network — do NOT use localhost in Docker)
PGHOST=postgres
PGPORT=5432
PGDATABASE=playground
PGUSER=playground
PGPASSWORD=change-me-to-a-strong-db-password

# API listen settings (bound inside Docker; Nginx proxies to this)
PORT=3000
HOST=0.0.0.0

# Rate limit: max requests per window per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Max JSON body size (bytes-ish via express limit string)
BODY_LIMIT=16kb
